# Chiave gratuita: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Opzionali: override dei modelli usati (lista aggiornata: https://openrouter.ai/openrouter/free)
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Rate limiting giornaliero (protegge la quota gratuita OpenRouter quando l'app è pubblica).
# Senza queste due variabili il rate limit è disattivato (comodo in locale).
# Crea un database gratuito su https://console.upstash.com (Redis > REST API).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opzionali: soglie giornaliere (default 200 globale, 6 per IP)
# DAILY_GLOBAL_LIMIT=200
# DAILY_IP_LIMIT=6
